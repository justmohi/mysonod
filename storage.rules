rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return signedIn() &&
        request.auth.token.email == 'mohistudio95@gmail.com';
    }

    function canManageUnionBranding(operatorId) {
      return signedIn() &&
        (
          isPrimaryAdmin() ||
          request.auth.uid == operatorId
        );
    }

    function isAllowedBrandingFile(fileName) {
      return fileName == 'govtLogoUrl' ||
        fileName == 'unionLogoUrl' ||
        fileName == 'watermarkLogoUrl';
    }

    match /union_settings/{operatorId}/{fileName} {
      // These branding assets are intentionally publicly readable because
      // certificates and public QR verification pages can display them.
      allow read: if isAllowedBrandingFile(fileName);

      // Only the same operator or the primary admin can create/replace branding.
      // Limit uploads to the three expected branding files, images, and 5 MB.
      allow create, update: if canManageUnionBranding(operatorId) &&
        isAllowedBrandingFile(fileName) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      // Deletes are handled separately because delete requests have no
      // request.resource object.
      allow delete: if canManageUnionBranding(operatorId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
