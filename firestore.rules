rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mohistudio95@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isPrimaryAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOperator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator';
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function applicationEditFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'applicantNameBn', 'applicantNameEn', 'userName',
            'fatherName', 'fatherNameEn',
            'motherName', 'motherNameEn',
            'spouseName', 'spouseNameEn',
            'gender', 'maritalStatus',
            'nidOrBirthReg', 'mobile', 'email', 'dob', 'occupation',
            'presentVillage', 'presentVillageEn',
            'presentWard', 'presentPost', 'presentPostEn',
            'presentUpazila', 'presentUpazilaEn',
            'presentDistrict', 'presentDistrictEn',
            'permanentVillage', 'permanentVillageEn',
            'permanentWard', 'permanentPost', 'permanentPostEn',
            'permanentUpazila', 'permanentUpazilaEn',
            'permanentDistrict', 'permanentDistrictEn',
            'village', 'villageEn', 'wardNo', 'postOffice', 'postOfficeEn',
            'holdingNo',
            'annualIncome', 'incomeSource', 'monthlyIncome',
            'businessName', 'businessType', 'businessNature', 'businessAddress',
            'businessCapital', 'businessStartDate', 'showCapitalOnPrint',
            'fiscalYear', 'ownerName', 'ownerFatherOrHusbandName',
            'ownerMotherName', 'ownerNidOrBirth', 'tinNumber', 'ownerPhotoUrl',
            'validityStart', 'validityEnd', 'licenseFee', 'vatAmount',
            'professionTax', 'tradeTax', 'totalAmount',
            'heirs', 'familyMembers',
            'deceasedPersonName', 'deceasedDate', 'deceasedIdType', 'deceasedIdNumber',
            'deceasedFatherOrHusbandType', 'deceasedFatherOrHusbandName',
            'applicantRelation', 'deceasedPhotoUrl', 'previousHusbandName',
            'deathPersonName', 'deathDate', 'deathPlace',
            'nationality', 'communityName', 'religion',
            'voterAreaOld', 'voterAreaNew', 'voterTransferReason',
            'correctionField', 'correctionOldValue', 'correctionNewValue',
            'correctionDetails',
            'guardianName', 'guardianRelation', 'permissionPurpose',
            'landDescription', 'landAmount',
            'agricultureType', 'agricultureLand',
            'freedomFighterName', 'freedomFighterRelation', 'freedomFighterNumber',
            'disabilityType', 'disabilityDescription',
            'unemploymentDuration',
            'constructionType', 'constructionLocation', 'constructionPurpose',
            'previousAddress', 'newAddress',
            'sameNamePerson', 'sameNameRelation', 'familyGuardianType', 'guardianType',
            'marriageDate', 'spouseName2',
            'orphanGuardian', 'miscellaneousDetails',
            'organizationName', 'nocPurpose', 'insolvencyReason',
            'childlessYears', 'reasonNoBirthCert', 'rohingyaVerificationRef',
            'generalPurpose', 'certificateDetails', 'notes',
            'attachmentUrls', 'updatedAt'
          ]);
    }

    match /test/connection {
      allow read: if true;
    }

    // Only the primary admin should control the admin registry.
    match /admins/{adminId} {
      allow read: if isStaff();
      allow write: if isPrimaryAdmin();
    }

    // User profiles.
    // Public registration can only create a normal citizen profile.
    // Operators can never change their own role from the client.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();

      allow create: if isSignedIn() && (
        (
          isOwner(userId) &&
          request.resource.data.role == 'user'
        ) ||
        (
          isPrimaryAdmin() &&
          request.resource.data.role == 'operator'
        ) ||
        (
          isPrimaryAdmin() &&
          request.resource.data.role == 'admin'
        )
      );

      allow update: if (
        isAdmin() &&
        (
          request.resource.data.role == resource.data.role ||
          (
            isPrimaryAdmin() &&
            (
              request.resource.data.role == 'operator' ||
              request.resource.data.role == 'admin' ||
              request.resource.data.role == 'user'
            )
          )
        )
      ) ||
        (
          isOwner(userId) &&
          resource.data.role == 'user' &&
          request.resource.data.role == 'user'
        ) ||
        (
          isOwner(userId) &&
          resource.data.role == 'operator' &&
          request.resource.data.role == 'operator'
        );

      allow delete: if isAdmin();
    }

    // Certificate applications.
    // Citizens create and edit their own applications only while Pending.
    // Staff can review and approve/reject applications.
    match /applications/{applicationId} {
      // Primary admin can read all applications.
      // Operators can only read applications they submitted themselves.
      // Citizens can only read applications they submitted themselves.
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn() && (
        isStaff() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'Pending'
        )
      );

      // Primary admin can update any application.
      // An operator can only edit an application they submitted, and cannot change
      // ownership, status, or other protected/system fields.
      // Citizens can only edit their own Pending applications.
      allow update: if isAdmin() ||
        (
          isOperator() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status &&
          applicationEditFieldsOnly()
        ) ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          resource.data.status == 'Pending' &&
          request.resource.data.status == 'Pending' &&
          applicationEditFieldsOnly()
        );

      allow delete: if isAdmin();
    }

    // Shared citizen identity/address profile.
    // Operators can reuse citizen-entered information by NID, but the profile
    // contains no application tracking, billing, operator, account or union data.
    match /citizen_profiles/{profileId} {
      allow read: if isStaff();

      allow create: if isStaff() &&
        request.resource.data.profileId == profileId &&
        request.resource.data.keys().hasOnly([
          'profileId',
          'applicantNameBn', 'applicantNameEn',
          'fatherName', 'fatherNameEn',
          'motherName', 'motherNameEn',
          'spouseName', 'spouseNameEn',
          'gender', 'maritalStatus',
          'mobile', 'dob', 'occupation',
          'holdingNo',
          'presentVillage', 'presentVillageEn',
          'presentWard', 'presentPost', 'presentPostEn',
          'presentUpazila', 'presentUpazilaEn',
          'presentDistrict', 'presentDistrictEn',
          'permanentVillage', 'permanentVillageEn',
          'permanentWard', 'permanentPost', 'permanentPostEn',
          'permanentUpazila', 'permanentUpazilaEn',
          'permanentDistrict', 'permanentDistrictEn',
          'village', 'villageEn', 'wardNo',
          'postOffice', 'postOfficeEn',
          'guardianType', 'familyGuardianType',
          'updatedAt'
        ]);

      allow update: if isStaff() &&
        resource.data.profileId == profileId &&
        request.resource.data.profileId == profileId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicantNameBn', 'applicantNameEn',
          'fatherName', 'fatherNameEn',
          'motherName', 'motherNameEn',
          'spouseName', 'spouseNameEn',
          'gender', 'maritalStatus',
          'mobile', 'dob', 'occupation',
          'holdingNo',
          'presentVillage', 'presentVillageEn',
          'presentWard', 'presentPost', 'presentPostEn',
          'presentUpazila', 'presentUpazilaEn',
          'presentDistrict', 'presentDistrictEn',
          'permanentVillage', 'permanentVillageEn',
          'permanentWard', 'permanentPost', 'permanentPostEn',
          'permanentUpazila', 'permanentUpazilaEn',
          'permanentDistrict', 'permanentDistrictEn',
          'village', 'villageEn', 'wardNo',
          'postOffice', 'postOfficeEn',
          'guardianType', 'familyGuardianType',
          'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /balance_requests/{requestId} {
      allow read: if isSignedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow create: if isSignedIn() &&
        (
          request.resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Global/default union settings remain public-readable and admin-controlled.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Each operator gets an isolated union workspace keyed by their Auth UID.
    // Admins can manage every workspace; operators can only access their own.
    // The role is checked from the authoritative /users profile document.
    match /union_settings/{operatorId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == operatorId &&
          get(/databases/$(database)/documents/users/$(operatorId)).data.role == 'operator'
        );

      allow create: if isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == operatorId &&
          get(/databases/$(database)/documents/users/$(operatorId)).data.role == 'operator'
        );

      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == operatorId &&
          get(/databases/$(database)/documents/users/$(operatorId)).data.role == 'operator'
        );

      allow delete: if isAdmin();
    }

    // Public QR verification snapshots. Reading a verification record is
    // intentionally anonymous; writing remains restricted to staff.
    match /public_verifications/{trackingId} {
      allow read: if true;
      allow create, update: if isStaff() &&
        request.resource.data.status == 'Verified' &&
        request.resource.data.trackingId == trackingId;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
