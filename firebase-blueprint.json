{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with wallet balance and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "balance", "role"]
    },
    "CertificateApplication": {
      "title": "CertificateApplication",
      "description": "Certificate application data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingId": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string" },
        "userName": { "type": "string", "maxLength": 100 },
        "certificateType": { "type": "string", "maxLength": 50 },
        "certificateTitleBn": { "type": "string", "maxLength": 100 },
        "applicantNameBn": { "type": "string", "maxLength": 100 },
        "applicantNameEn": { "type": "string", "maxLength": 100 },
        "fatherName": { "type": "string", "maxLength": 100 },
        "motherName": { "type": "string", "maxLength": 100 },
        "spouseName": { "type": "string", "maxLength": 100 },
        "nidOrBirthReg": { "type": "string", "maxLength": 50 },
        "mobile": { "type": "string", "maxLength": 20 },
        "village": { "type": "string", "maxLength": 100 },
        "wardNo": { "type": "string", "maxLength": 10 },
        "postOffice": { "type": "string", "maxLength": 50 },
        "fee": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "issuingOfficer": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["id", "trackingId", "userId", "certificateType", "applicantNameBn", "fee", "status", "createdAt"]
    },
    "BalanceRequest": {
      "title": "BalanceRequest",
      "description": "Manual balance top-up request via bKash/Nagad/Rocket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["bKash", "Nagad", "Rocket"] },
        "senderNumber": { "type": "string", "maxLength": 20 },
        "trxId": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "requestedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "amount", "method", "senderNumber", "trxId", "status", "requestedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet balance audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["fee_deduction", "balance_topup", "welcome_bonus"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 },
        "referenceId": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "balanceAfter", "createdAt"]
    },
    "UnionSettings": {
      "title": "UnionSettings",
      "description": "Union Parishad administrative authority details, contact info, and dynamic logo URLs",
      "type": "object",
      "properties": {
        "unionName": { "type": "string", "maxLength": 150 },
        "unionNameEn": { "type": "string", "maxLength": 150 },
        "postOffice": { "type": "string", "maxLength": 100 },
        "postOfficeEn": { "type": "string", "maxLength": 100 },
        "upazila": { "type": "string", "maxLength": 100 },
        "upazilaEn": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "districtEn": { "type": "string", "maxLength": 100 },
        "chairmanName": { "type": "string", "maxLength": 100 },
        "chairmanNameEn": { "type": "string", "maxLength": 100 },
        "mobileNumber": { "type": "string", "maxLength": 50 },
        "officialEmail": { "type": "string", "maxLength": 100 },
        "govtLogoUrl": { "type": "string", "maxLength": 1000 },
        "unionLogoUrl": { "type": "string", "maxLength": 1000 },
        "watermarkLogoUrl": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["unionName", "postOffice", "upazila", "district", "chairmanName", "mobileNumber", "officialEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and wallet balances"
    },
    "/applications/{applicationId}": {
      "schema": "CertificateApplication",
      "description": "Citizen certificate and license applications"
    },
    "/balance_requests/{requestId}": {
      "schema": "BalanceRequest",
      "description": "Top-up requests pending or approved by admin"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Ledger of wallet debits and credits"
    },
    "/settings/{settingId}": {
      "schema": "UnionSettings",
      "description": "Administrative authority and portal branding settings"
    }
  }
}
